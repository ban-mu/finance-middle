{# live 海报：直播预告型，750x1334，配色由 colorthief 自动提取 #}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { width: 750px; height: 1334px; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; background: linear-gradient(160deg, {{ primaryColor }} 0%, #1A1A2E 100%); color: #fff; position: relative; overflow: hidden; }
    .live-tag { position: absolute; top: 50px; left: 50px; background: #FF3B30; padding: 8px 20px; border-radius: 6px; font-size: 22px; font-weight: 700; letter-spacing: 1px; }
    .live-tag::before { content: ''; display: inline-block; width: 10px; height: 10px; background: #fff; border-radius: 50%; margin-right: 8px; animation: blink 1s infinite; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }
    .hero { width: 100%; height: 560px; background: rgba(255,255,255,.08); display: flex; align-items: center; justify-content: center; font-size: 40px; }
    .body { padding: 60px 50px; }
    .title { font-size: 56px; font-weight: 800; margin-bottom: 24px; line-height: 1.3; }
    .host { font-size: 28px; opacity: .9; margin-bottom: 40px; }
    .host .avatar { display: inline-block; width: 60px; height: 60px; border-radius: 50%; background: {{ primaryColor }}; vertical-align: middle; margin-right: 14px; }
    .info-row { display: flex; gap: 30px; margin-bottom: 40px; }
    .info-row .it { background: rgba(255,255,255,.1); padding: 20px 30px; border-radius: 12px; }
    .info-row .it .k { font-size: 20px; opacity: .8; }
    .info-row .it .v { font-size: 30px; font-weight: 700; margin-top: 6px; }
    .desc { font-size: 26px; line-height: 1.6; opacity: .92; }
    .qr { position: absolute; right: 50px; bottom: 50px; width: 140px; height: 140px; background: #fff; padding: 8px; border-radius: 14px; }
    .qr img { width: 100%; height: 100%; }
    .ts { position: absolute; left: 50px; bottom: 70px; font-size: 22px; opacity: .8; }
  </style>
</head>
<body>
  <div class="live-tag">LIVE 直播</div>
  <div class="hero">{{ heroText or '直播预告' }}</div>
  <div class="body">
    <div class="title">{{ title or '稳健理财节 · 财富直播' }}</div>
    <div class="host"><span class="avatar"></span>主播：{{ host or '理财官 · 小财' }}</div>
    <div class="info-row">
      <div class="it"><div class="k">开播时间</div><div class="v">{{ liveTime or '今晚 20:00' }}</div></div>
      <div class="it"><div class="k">预约人数</div><div class="v">{{ subscribeCount or '1286' }}</div></div>
    </div>
    <div class="desc">{{ desc or '锁定直播间，理财专家为你解读最新市场行情' }}</div>
  </div>
  <div class="qr"><img src="{{ qrDataUrl }}" alt="qr"/></div>
  <div class="ts">扫码预约直播 · {{ generatedAt }}</div>
</body>
</html>
