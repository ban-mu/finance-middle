{# strategy 海报：投资策略分享，750x1200 #}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { width: 750px; height: 1200px; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; background: #F5F7FA; color: #1A1A2E; position: relative; overflow: hidden; }
    .head { background: {{ primaryColor }}; color: #fff; padding: 70px 50px 50px; }
    .head .t1 { font-size: 30px; opacity: .85; margin-bottom: 14px; }
    .head .t2 { font-size: 56px; font-weight: 800; line-height: 1.3; }
    .body { padding: 50px; }
    .point { background: #fff; border-radius: 14px; padding: 30px; margin-bottom: 24px; box-shadow: 0 6px 16px rgba(0,0,0,.06); }
    .point .n { display: inline-block; width: 40px; height: 40px; line-height: 40px; text-align: center; background: {{ primaryColor }}; color: #fff; border-radius: 50%; font-size: 22px; font-weight: 700; margin-right: 14px; }
    .point .t { font-size: 30px; font-weight: 700; display: inline-block; vertical-align: middle; }
    .point .d { font-size: 24px; color: #666; margin-top: 14px; line-height: 1.5; }
    .qr { position: absolute; right: 40px; bottom: 40px; width: 120px; height: 120px; background: #fff; padding: 6px; border-radius: 12px; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
    .qr img { width: 100%; height: 100%; }
    .ts { position: absolute; left: 50px; bottom: 60px; font-size: 20px; color: #999; }
  </style>
</head>
<body>
  <div class="head">
    <div class="t1">投资策略</div>
    <div class="t2">{{ title or '稳健理财三步走' }}</div>
  </div>
  <div class="body">
    {% for p in points or defaultPoints %}
      <div class="point">
        <span class="n">{{ loop.index }}</span><span class="t">{{ p.t }}</span>
        <div class="d">{{ p.d }}</div>
      </div>
    {% endfor %}
  </div>
  <div class="qr"><img src="{{ qrDataUrl }}" alt="qr"/></div>
  <div class="ts">扫码查看完整策略 · {{ generatedAt }}</div>
  <script>
    // 提供给模板用的默认数据
    window.__defaultPoints = [
      { t: '明确目标', d: '先确定理财目标：收益预期、可投资期限与风险承受能力。' },
      { t: '资产配置', d: '股债均衡，分散单一品种风险，定期再平衡。' },
      { t: '长期持有', d: '避免频繁交易，时间复利是稳健收益的最好朋友。' }
    ];
  </script>
  {% set defaultPoints = [
    { t: '明确目标', d: '先确定理财目标：收益预期、可投资期限与风险承受能力。' },
    { t: '资产配置', d: '股债均衡，分散单一品种风险，定期再平衡。' },
    { t: '长期持有', d: '避免频繁交易，时间复利是稳健收益的最好朋友。' }
  ] %}
</body>
</html>
